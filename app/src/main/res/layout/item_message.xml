<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:background="#121212">

    <LinearLayout
        android:id="@+id/sentImageLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="80dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/sentImageView"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:background="#2C2C2C"
            android:padding="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/receivedImageLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginEnd="80dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/receivedImageSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="보낸 사람"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:paddingBottom="4dp" />

        <ImageView
            android:id="@+id/receivedImageView"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:background="#2C2C2C"
            android:padding="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sentMessageLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textViewSentMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2C2C2C"
            android:padding="12dp"
            android:text="보낸 메시지"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/receivedMessageLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/receivedSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="보낸 사람"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/textViewReceivedMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2C2C2C"
            android:padding="12dp"
            android:text="받은 메시지"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>
</RelativeLayout>